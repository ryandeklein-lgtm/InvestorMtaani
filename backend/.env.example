NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=false

# Use DATABASE_URL on managed PostgreSQL services, or the DB_* fields below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=investor_mtaani
DB_USER=postgres
DB_PASSWORD=replace-me
DB_SSL=false
# Keep certificate checks enabled. Set false only when your database provider requires it.
DB_SSL_REJECT_UNAUTHORIZED=true

# Generate a unique secret with at least 32 characters. Never commit the real value.
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1d

# Generate a unique 32-byte (64 hexadecimal character) key for encrypted KYC.
KYC_ENCRYPTION_KEY=

# Optional: add NewsAPI articles; the configured publisher RSS feeds work without a key.
NEWS_API_KEY=
